APP_NAME="WebGIS Censimento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webgis
DB_USERNAME=webgis
DB_PASSWORD=webgis

# Nomi da cui il programma riconosce chi ha gia' fatto l'accesso. Se
# l'indirizzo digitato nel browser non compare qui, le pagine si aprono ma i
# dati rispondono "non autenticato" e restano vuoti.
# Sul server non si scrive a mano: deploy/set-domain.sh <dominio> lo aggiorna.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Portale pubblico dei committenti: dominio di base dei sottodomini, cioe' la
# parte dopo il nome del Comune (mentana.censimentoalberi.it). Vuoto = portale
# raggiungibile solo dal percorso di collaudo /comune/{indirizzo}.
# Sul server non si scrive a mano: deploy/set-portal-domain.sh <dominio>
PORTAL_BASE_HOST=
PORTAL_PATH_FALLBACK=true

# Sito aziendale sul dominio nudo (censimentoalberature.it, senza prefisso).
# Vuoto = il sito si vede solo dal percorso di collaudo /sito: e' voluto,
# perche' un sito senza recapiti e senza ragione sociale non va pubblicato.
SITO_BASE_HOST=
SITO_PATH_FALLBACK=true

# Dati dell'azienda mostrati sul sito. Quello che resta vuoto NON viene
# stampato: nessuna voce inventata su un sito che parla a un ufficio tecnico.
SITO_RAGIONE_SOCIALE=
SITO_SEDE=
SITO_PIVA=
SITO_REA=
SITO_TERRITORIO=
SITO_ESPERIENZA=
SITO_TELEFONO=
SITO_EMAIL=
SITO_PEC=
SITO_ORARI=
SITO_INDIRIZZO=
# Chi firma le perizie di stabilita', con il titolo vero
SITO_PERIZIE_FIRMATARIO=
SITO_PERIZIE_TITOLO=
# Un portale comunale vero da mostrare come esempio (con il consenso dell'ente)
SITO_PORTALE_ESEMPIO_URL=
SITO_PORTALE_ESEMPIO_NOME=

# Sfondi della mappa pubblica. I valori predefiniti sono servizi pubblici a
# uso corretto e con attribuzione, non contratti: prima di consegnare a un
# ente che paga conviene un fornitore con chiave, che si collega cambiando
# solo queste righe. Uno sfondo senza indirizzo sparisce dal selettore.
# Alternativa stradale piu' colorata:
#   https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
# Vanno lasciate commentate finche' non si cambia fornitore: una riga vuota
# non vale "usa il predefinito", vale "vuoto", e lo sfondo sparirebbe.
#PORTAL_TILES_STRADALE=
#PORTAL_TILES_STRADALE_ATTR=
#PORTAL_TILES_SATELLITE=
#PORTAL_TILES_SATELLITE_ATTR=
#PORTAL_TILES_SCURA=
#PORTAL_TILES_SCURA_ATTR=
# Livello di ingrandimento oltre il quale quel fornitore non ha piu' immagini.
# Dichiararlo evita che la mappa si svuoti ingrandendo: da li' in poi ingrandisce
# l'ultima immagine disponibile. 19 e' il valore prudente che vale per quasi tutti.
#PORTAL_TILES_STRADALE_ZOOM=19
#PORTAL_TILES_SATELLITE_ZOOM=19
#PORTAL_TILES_SCURA_ZOOM=19

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=webgis
AWS_SECRET_ACCESS_KEY=webgis-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=webgis-dev
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000

VITE_APP_NAME="${APP_NAME}"

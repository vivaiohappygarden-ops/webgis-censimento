# Configurazione di produzione — copiare in /var/www/webgis/.env e completare.
# Lo script provision.sh genera automaticamente APP_KEY e la password del database.

APP_NAME="WebGIS Censimento"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Indirizzo pubblico dell'applicazione (con https)
APP_URL=https://SOSTITUIRE.esempio.it
APP_LOCALE=it
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webgis
DB_USERNAME=webgis
DB_PASSWORD=SOSTITUIRE

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# v1: file su disco del VPS (inclusi nel backup). Quando i volumi crescono,
# passare ad Aruba Object Storage (S3 compatibile) cambiando disco e credenziali.
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Posta in uscita per il riepilogo scadenze (vedi docs/DEPLOY-ARUBA.md).
# Con una casella Aruba: host smtps.aruba.it, porta 465, cifratura ssl,
# nome utente = indirizzo completo della casella.
MAIL_MAILER=log
MAIL_HOST=smtps.aruba.it
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=SOSTITUIRE@esempio.it
MAIL_PASSWORD=SOSTITUIRE
MAIL_FROM_ADDRESS=SOSTITUIRE@esempio.it
MAIL_FROM_NAME="${APP_NAME}"

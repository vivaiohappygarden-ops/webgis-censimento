# Caddy: HTTPS automatico (Let's Encrypt) e reverse proxy verso PHP-FPM.
# Sostituire i domini e poi: cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
#
# Due blocchi:
#  1. il dominio del gestionale (dove lavorano impresa e operatori);
#  2. i sottodomini dei portali pubblici dei committenti, con certificato
#     rilasciato al volo alla prima visita.
#
# Il certificato al volo non è aperto a chiunque: prima di chiederlo Caddy
# interroga l'applicazione, che risponde "sì" solo per i sottodomini di un
# committente con il portale acceso. Senza questo controllo chiunque potrebbe
# far emettere certificati puntando un proprio nome sul nostro server.

{
	on_demand_tls {
		ask http://127.0.0.1/interno/tls
		interval 2m
		burst 5
	}
}

(comune) {
	root * /var/www/webgis/public
	encode zstd gzip

	php_fastcgi unix//run/php/php8.4-fpm.sock

	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Gli asset compilati hanno il nome con hash: cache lunga
	@static path /build/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/webgis-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

# 1) Gestionale
SOSTITUIRE.esempio.it {
	import comune

	# HSTS solo sul dominio del gestionale: estenderlo ai sottodomini
	# obbligherebbe ogni nuovo Comune a essere in HTTPS prima ancora di
	# avere il certificato
	header Strict-Transport-Security "max-age=31536000"
}

# 2) Portali pubblici dei Comuni: mentana.PORTALE.esempio.it, ...
# Il record DNS di ogni Comune (o un record jolly) deve puntare a questo server.
*.PORTALE.esempio.it {
	tls {
		on_demand
	}

	import comune
}
